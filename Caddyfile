# LibreChat本体のHTTPS化（ポート443）
:443, your-domain.local:443 {
    reverse_proxy librechat:3080
    
    # 自己署名証明書の自動生成（デフォルト）
    # ※社内CA等のカスタム証明書を使用する場合は、コメントアウトを切り替えてください。
    tls internal
    # tls /certs/librechat.crt /certs/librechat.key
}

# Sandpack BundlerのHTTPS化（ポート8443）
:8443, your-domain.local:8443 {
    reverse_proxy sandpack-bundler:80
    
    # 自己署名証明書の自動生成（デフォルト）
    # ※社内CA等のカスタム証明書を使用する場合は、コメントアウトを切り替えてください。
    tls internal
    # tls /certs/librechat.crt /certs/librechat.key
}
