# =============================================================================
# LibreChat & Code Interpreter API 環境変数設定テンプレート
# =============================================================================
# このファイルは、LibreChat本体と Code Interpreter API (RCE) の両方の設定を網羅しています。
# 「cp .env.librechat .env」としてコピーするだけで、最低限のテスト動作が可能です。
#
# 【重要】セキュリティのため、運用環境では必ず以下の「変更必須項目」を更新してください。
# =============================================================================

# -----------------------------------------------------------------------------
# ■ 変更必須項目 (セキュリティ・認証設定)
# -----------------------------------------------------------------------------

# [REQUIRED] JWT 認証用のシークレットキー。
# 運用環境では必ず推測困難な32文字以上のランダムな文字列に変更してください。
JWT_SECRET=32_char_secret_key_used_for_testing_123
JWT_REFRESH_SECRET=32_char_refresh_key_used_for_testing_456

# [REQUIRED] 認証情報の暗号化キーとIV。
# 運用環境では必ず変更してください。
CREDS_KEY=f34be427ebaeded2940f7d30100edb51
CREDS_IV=12345678901234567890123456789012

# [REQUIRED] APIアクセスのための共有キー。
# API サーバーと LibreChat の間で一致させる必要があります。
LIBRECHAT_CODE_API_KEY=

# -----------------------------------------------------------------------------
# ■ デフォルトで動作可能な設定項目
# -----------------------------------------------------------------------------

# 1. API サーバー (FastAPI) & Docker Socket Proxy
# -----------------------------------------------------------------------------

# Docker APIへの接続URL。通常は変更不要です。
DOCKER_HOST=tcp://docker-proxy:2375

# 2. Code Interpreter サンドボックス (RCE) 設定
# -----------------------------------------------------------------------------

# 実行環境として使用する Docker イメージ。
RCE_IMAGE_NAME=custom-rce-kernel:latest

# API認証の一時無効化 (true/false)。
# テスト時やヘッダー送信不具合の回避用（本番環境では false 推奨）。
DISABLE_CODE_API_AUTH=false

# 許可するCORSオリジンのカンマ区切りホワイトリスト（'*' はセキュリティ上禁止）。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3080,https://localhost

# 各コンテナのメモリ制限。
RCE_MEM_LIMIT=512m

# 各コンテナのCPU制限（ナノ秒）。500000000 = 0.5 CPU。
RCE_CPU_LIMIT=500000000

# 最大同時セッション数。
RCE_MAX_SESSIONS=100

# アイドルコンテナの有効期限（秒）。
# 待機中コンテナは軽量なため、会話コンテキストを長く保持したい場合は 14400 (4時間) や 86400 (24時間) も実用的です。
RCE_SESSION_TTL=3600

# 外部ネットワークアクセスの許可 (true/false)。
RCE_NETWORK_ENABLED=false

# GPU の有効化 (true/false)。
RCE_GPU_ENABLED=false

# 3. ファイルストレージ & 永続化
# -----------------------------------------------------------------------------

# [ADVANCED/OPTIONAL] ホスト側のデータ保存用ディレクトリ。
# 未設定（コメントアウト）の場合、コンテナ内の一時ストレージを使用します（設定不要ですぐに動きます）。
# 設定すると、ファイルの永続化と、大規模ファイルに対する高速なアクセスが有効になります。
#
# 【重要】
# 1. Docker APIの仕様により、必ず「絶対パス」で指定してください。
# 2. Linux環境では、マウント先ディレクトリに UID 1000 (apiuser) の書き込み権限が必要です。
#    権限エラーが出る場合は、ホスト側で「sudo chown -R 1000:1000 <ディレクトリパス>」を実行してください。
#
# 例: RCE_DATA_DIR=/home/user/Project/sessions
# RCE_DATA_DIR=/absolute/path/to/your/project/sessions

# APIコンテナ内部でのセッションデータ保存パス（通常は変更不要です）。
RCE_DATA_DIR_INTERNAL=/app/shared_volumes/sessions

# LibreChatのファイル保存形式。
STORAGE_TYPE=local

# LibreChatのファイル保存ディレクトリ。
FILES_DIR=/app/api/data/files
IMAGES_DIR=/app/api/data/images

# 4. LibreChat 基本インフラ (DB, 検索)
# -----------------------------------------------------------------------------

# PostgreSQL (pgvector) 認証情報。
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

# MongoDB 接続 URL。
MONGO_URI=mongodb://mongodb:27017/LibreChat

# Meilisearch 設定。
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=your_master_key
MEILI_NO_ANALYTICS=true

# LibreChat 設定ファイルのパス。
CONFIG_PATH=/app/librechat.yaml
CONFIG_BYPASS_VALIDATION=true
ALLOW_REGISTRATION=true

# 5. 連携設定
# -----------------------------------------------------------------------------

# LibreChatからAPIへの接続パス。
LIBRECHAT_CODE_BASEURL=http://librechat_code_interpreter_api:8000

# 6. AI モデル設定
# -----------------------------------------------------------------------------

# 表示させたい
# ENDPOINTS=agents, openAI, google, anthropic, assistants, azureOpenAI, azureAssistants, agents, custom, bedrock

# OpenAI API (テスト用にダミーキーを設定済み)
OPENAI_API_KEY=sk-dummy-key-for-ui-testing

# Google Gemini 設定（librechat.yaml の google エンドポイントから直接参照）
# GEMINI_API_KEY=your_gemini_api_key

# Ollama 設定
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODELS=qwen2.5-coder:3b

# 外部互換 API (例: さくらインターネット等)
EXTERNAL_API_URL=${EXTERNAL_API_URL}
EXTERNAL_API_KEY=${EXTERNAL_API_KEY}
EXTERNAL_LLM_MODEL=${EXTERNAL_LLM_MODEL}

# 7. サーバー起動設定
# -----------------------------------------------------------------------------

HOST=0.0.0.0
PORT=3080

# LibreChat のホスト公開ポート（コンテナ外からアクセスする際のポート番号）。
LIBRECHAT_PORT=3000

# Sandpack Bundler のホスト公開ポート（ssl-mode プロファイル使用時）。
SANDPACK_PORT=8080

# Nginx / SSL のホスト公開ポート（ssl-mode プロファイル使用時）。
HTTP_PORT=80
HTTPS_PORT=443
SANDPACK_HTTPS_PORT=8443

# LibreChat Web画面のログインセッション有効期限（ミリ秒）。
# 例: 24時間 = 1000 * 60 * 60 * 24 = 86400000
SESSION_EXPIRY=86400000

# =============================================================================
# ■ オフライン・ローカル環境用 Sandpack バンドラー設定
# =============================================================================
# Artifacts（React等のUI描画機能）をローカル環境で動作させるための設定です。
#
# 【フェーズ1: 非SSL環境 (デフォルト)】
# 他のPC等のブラウザから http://<サーバーIP>:3000 でアクセスする場合、
# ブラウザのセキュリティ制限（Service Worker制限）によりローカルBundlerへの通信はブロックされます。
# そのため、以下の設定値は「指定なし（空値）」にするかコメントアウトしてください。
# SANDPACK_BUNDLER_URL=

# 【フェーズ2: Nginx SSLテスト環境 (自己署名証明書)】
# Nginxを用いてローカルHTTPS化（例: https://localhost または https://<サーバーIP>）を
# 行う場合は、ssl-mode プロファイルを使用し、HTTPS形式の接続先を指定してください。
# SANDPACK_BUNDLER_URL=https://localhost:8443

# 【フェーズ3: オンプレミス本番 / 正式なCA証明書の適用】
# 信頼された認証局（Let's Encrypt / 社内プライベートPKI / 商用CA）から発行された証明書がある場合は、
# ./certs/server.crt および ./certs/server.key に配置して Nginx をリロードしてください。
# （詳細は docs/infrastructure/reverse-proxy.md を参照）
